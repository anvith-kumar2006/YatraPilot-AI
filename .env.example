# ============================================================
# YatraPilot AI â€” Environment Configuration
# ============================================================

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
PORT=5000
PUBLIC_URL=https://your-domain.ngrok-free.dev

# Google Gemini AI (gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Murf AI Text-to-Speech (Falcon 2.1)
MURF_API_KEY=your_murf_api_key_here
MURF_REGION=IN

# PostgreSQL Database (Neon Cloud)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Geoapify Places & Geocoding (Active Provider)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Agora Conversational AI
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret

# ============================================================
# TRANSPORTATION MARKETPLACE INTEGRATIONS
# ============================================================

# 1. MAPTILER CLOUD (Vector/Raster Map Tiles, Geocoding, Routing)
# Sign up at: https://cloud.maptiler.com/
MAPTILER_API_KEY=your_maptiler_api_key_here

# 2. OSRM (Open Source Routing Machine â€” Public Road Routing)
# Public demo: https://router.project-osrm.org
OSRM_ROUTING_URL=https://router.project-osrm.org

# 3. OPENSTREETMAP / NOMINATIM (Public Geocoding)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# 4. INDIA GTFS (Reclaim City Public Transit Feeds)
INDIA_GTFS_API_URL=https://api.reclaim.city
INDIA_GTFS_FEEDS_URL=https://maps.reclaim.city/gtfs/feeds.json
RECLAIM_CITY_API_KEY=your-reclaim-city-api-key

# 5. MOBILITY DATABASE (Public Transit Feed Discovery)
MOBILITY_DATABASE_API_URL=https://api.mobilitydatabase.org/v1
MOBILITY_DATABASE_API_KEY=your-mobility-database-api-key
MOBILITY_DATABASE_REFRESH_TOKEN=your-mobility-database-refresh-token

# 6. ETRAVELSMART BUS API (Commercial B2B Partner Only)
# Documentation: https://b2b.etravelsmart.com/bus/busApi.htm
ETRAVELSMART_ENABLED=false
ETRAVELSMART_API_URL=https://b2b.etravelsmart.com/bus/busApi.htm
ETRAVELSMART_USER_ID=your_etravelsmart_user_id
ETRAVELSMART_PASSWORD=your_etravelsmart_password
ETRAVELSMART_API_KEY=your-etravelsmart-api-key

# 7. REDBUS SEATSELLER (Commercial Partner Only)
REDBUS_ENABLED=false
REDBUS_SEATSELLER_API_URL=https://api.seatseller.travel
REDBUS_SEATSELLER_KEY=your_seatseller_key_here

# 8. IRCTC PARTNER NETWORK (Authorized Commercial Access Only)
IRCTC_ENABLED=false
IRCTC_PARTNER_API_URL=https://api.irctcpartner.com
IRCTC_PARTNER_KEY=your_irctc_partner_key_here

# 9. AMADEUS TRAVEL API (Flight Offers â€” Commercial / Developer Account)
AMADEUS_ENABLED=false
AMADEUS_BASE_URL=https://test.api.amadeus.com/v2
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# 10. DUFFEL FLIGHTS API (Commercial / Developer Account)
DUFFEL_ENABLED=false
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_KEY=your_duffel_api_key_here
